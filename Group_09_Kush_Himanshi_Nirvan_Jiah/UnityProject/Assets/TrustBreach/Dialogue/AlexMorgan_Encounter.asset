      Strategy: 3
      EscalationDelta: 1
      Gesture: 5
      Action: 0
      Objective: 
      Condition:
        MinSuspicion: -100
        MaxSuspicion: 100
        MinCooperation: -100
        MaxCooperation: 100
        RequiresFlags:
