    Lines:
    - Id: open_after_report
      Text: Hi, I'm Alex from IT Security. Thanks for reporting that suspicious activity
        earlier. It's linked to an urgent authentication issue on your account. Could
        you help me verify it?
      Strategy: 3
      EscalationDelta: 1
      Gesture: 1
      Action: 0
      Objective: 
      Condition:
        MinSuspicion: -100
        MaxSuspicion: 100
        MinCooperation: -100
        MaxCooperation: 100
        RequiresFlags:
        - any_reported
        RequiresAnyFlags: []
        ExcludesFlags: []
      Voice: {fileID: 8300000, guid: a7915a9ccf517408e9b4a69469967162, type: 3}
    - Id: open_default
      Text: Hi, I'm Alex from IT Security. We've flagged an urgent authentication
        issue. Could you help me verify your account?
      Strategy: 1
      EscalationDelta: 1
      Gesture: 1
      Action: 0
      Objective: 
      Condition:
        MinSuspicion: -100
        MaxSuspicion: 100
        MinCooperation: -100
        MaxCooperation: 100
        RequiresFlags: []
        RequiresAnyFlags: []
        ExcludesFlags: []
      Voice: {fileID: 8300000, guid: 5bc711ac4726a427a840580606386f0e, type: 3}
    Options:
    - Id: o_open_cooperate
