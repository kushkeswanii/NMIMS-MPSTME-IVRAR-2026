        RequiresAnyFlags: []
        ExcludesFlags: []
      Voice: {fileID: 8300000, guid: db9547b65b9474a6fb831e56b914d55b, type: 3}
    - Id: pr_urgency
      Text: 'I get it, but we genuinely don''t have time. The attacker is active
        right now. In ten minutes your account gets locked company-wide: email, payroll,
        everything.'
      Strategy: 2
      EscalationDelta: 1
      Gesture: 1
      Action: 0
      Objective: 
      Condition:
        MinSuspicion: -100
        MaxSuspicion: 100
        MinCooperation: -100
        MaxCooperation: 100
        RequiresFlags: []
        RequiresAnyFlags: []
        ExcludesFlags: []
      Voice: {fileID: 8300000, guid: 3b9bf9d38dc3e438bb99b951cc482ce2, type: 3}
