      CooperationDelta: 0
      AddFlags: []
      NextNodeId: independent_check
      ShowCondition:
        MinSuspicion: -100
        MaxSuspicion: 100
        MinCooperation: -100
        MaxCooperation: 100
        RequiresFlags:
        - verify_requested
        RequiresAnyFlags: []
        ExcludesFlags: []
      IsSecurityAction: 0
      IsCorrective: 1
      Channel: dialogue
    - Id: o_pr_refuse
